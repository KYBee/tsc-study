# 권리 검수 전 Part 2·7 이미지 60장을 production build에 포함할지 결정합니다.
# true는 해당 deployment의 명시적 opt-in이며 권리 승인 상태 변경이 아닙니다.
VITE_ENABLE_TSC_REVIEW_VISUAL_ASSETS=false

# 선택 사항: 최소 교정 JSON 계약을 구현한 same-origin 경로 또는 HTTPS URL.
# VITE_* 값은 브라우저에 공개되므로 API key나 provider secret을 넣지 않는다.
VITE_TSC_CORRECTION_API_URL=
