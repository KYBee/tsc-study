{
  "name": "tsc-study",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:run": "vitest run",
    "fixture:part4": "python3 scripts/build_part4_app_fixture.py",
    "validate:fixtures": "python3 scripts/build_part4_app_fixture.py --validate-only",
    "fixture:part4-full": "python3 scripts/build_part4_full_app_fixture.py",
    "validate:part4-full": "python3 scripts/build_part4_full_app_fixture.py --validate-only",
    "test:part4-full": "python3 -m unittest scripts.tests.test_build_part4_full_app_fixture -v",
    "fixture:part4-review": "python3 scripts/build_part4_review_fixture.py",
    "validate:part4-review": "python3 scripts/build_part4_review_fixture.py --validate-only",
    "test:part4-review": "python3 -m unittest scripts.tests.test_build_part4_review_fixture -v",
    "test:part4-promotion": "python3 -m unittest scripts.tests.test_promote_part4_reviewed_data -v",
    "fixture:text-parts": "python3 scripts/build_text_parts_app_fixture.py",
    "validate:text-parts": "python3 scripts/build_text_parts_app_fixture.py --validate-only",
    "test:text-parts": "python3 -m unittest scripts.tests.test_build_text_parts_app_fixture -v",
    "fixture:part2-visual": "python3 scripts/build_part2_visual_app_fixture.py",
    "validate:part2-visual": "python3 scripts/build_part2_visual_app_fixture.py --validate-only",
    "test:part2-visual": "python3 -m unittest scripts.tests.test_build_part2_visual_app_fixture -v",
    "fixture:part7-visual": "python3 scripts/build_part7_visual_app_fixture.py",
    "validate:part7-visual": "python3 scripts/build_part7_visual_app_fixture.py --validate-only",
    "test:part7-visual": "python3 -m unittest scripts.tests.test_build_part7_visual_app_fixture -v",
    "assets:visual-local": "python3 scripts/import_named_visual_assets.py --validate-only",
    "assets:part2-local": "npm run assets:visual-local",
    "assets:workbook-local": "python3 scripts/build_full_workbook_import.py --extract-assets",
    "validate:named-visual-assets": "python3 scripts/import_named_visual_assets.py --validate-only",
    "test:named-visual-assets": "python3 -m unittest scripts.tests.test_import_named_visual_assets -v",
    "validate:part2-assets": "python3 scripts/validate_part2_local_assets.py",
    "validate:part7-assets": "python3 scripts/validate_part7_local_assets.py",
    "dataset:course": "python3 scripts/build_course_working_import.py",
    "validate:course-dataset": "python3 scripts/build_course_working_import.py --validate-only",
    "test:course-dataset": "python3 -m unittest scripts.tests.test_build_course_working_import -v",
    "dataset:full": "python3 scripts/build_full_workbook_import.py",
    "validate:full-dataset": "python3 scripts/build_full_workbook_import.py --validate-only",
    "test:full-dataset": "python3 -m unittest scripts.tests.test_build_full_workbook_import -v",
    "check:data": "npm run validate:course-dataset && npm run test:course-dataset && npm run validate:full-dataset && npm run test:full-dataset",
    "check": "npm run assets:visual-local && npm run validate:named-visual-assets && npm run test:named-visual-assets && npm run fixture:part2-visual && npm run validate:part2-visual && npm run test:part2-visual && npm run fixture:part7-visual && npm run validate:part7-visual && npm run test:part7-visual && npm run fixture:text-parts && npm run validate:text-parts && npm run test:text-parts && npm run fixture:part4-full && npm run validate:part4-full && npm run test:part4-full && npm run fixture:part4-review && npm run validate:part4-review && npm run test:part4-review && npm run test:part4-promotion && npm run fixture:part4 && npm run validate:fixtures && npm run typecheck && npm run lint && npm run test:run && npm run build && npm run validate:part2-assets && npm run validate:part7-assets"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "7.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
